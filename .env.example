# プッシュ通知（アプリを閉じていても届く期限の通知）に使う環境変数。
# 値は `node scripts/push-keys.mjs` で作り、Vercel の Project Settings → Environment Variables に登録する。
# 未設定でもアプリは動く（通知はアプリを開いているあいだだけになる）。

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# 送信元の連絡先。公開したアプリの URL（https://...）か mailto: のアドレス
VAPID_SUBJECT=
# 定期実行の呼び出しを守る合言葉（Vercel Cron は自動で Authorization ヘッダーに付けて呼ぶ）
CRON_SECRET=

# 購読情報の保存先（Upstash Redis）。Vercel の Marketplace で Upstash を追加すると自動で入る
KV_REST_API_URL=
KV_REST_API_TOKEN=
